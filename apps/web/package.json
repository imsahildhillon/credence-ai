{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "eval:report": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/eval-report.ts",
    "worker": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local src/workers/analysis-worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@radix-ui/react-avatar": "^1.2.4",
    "@radix-ui/react-checkbox": "^1.3.9",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-separator": "^1.1.13",
    "@radix-ui/react-slot": "^1.3.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "15.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
