# Automatically normalize line endings for all text files, checked out as LF
* text=auto eol=lf

# Explicit text types
*.md       text eol=lf
*.markdown text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
