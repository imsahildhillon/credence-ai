# Copy to .env.local (per app, e.g. apps/web/.env.local) and fill in real
# values. Never commit real secrets.
#
# See README.md "Environment strategy" for the full explanation of these
# categories and why they're split this way.

# ── Required for application startup ─────────────────────────────────────
# The app fails fast (throws at boot) if any of these are missing or
# invalid. Validated eagerly by apps/web/src/config/env.ts.

# Supabase (database, auth backend, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (direct connection to the Supabase-hosted Postgres instance)
DATABASE_URL=

# Public configuration (client-safe base URL)
NEXT_PUBLIC_APP_URL=

# ── Required only for AI services ─────────────────────────────────────────
# NOT required at startup — the app boots without this. Validated lazily,
# the moment an AI module is actually invoked, by
# apps/web/src/lib/ai/env.ts. Anthropic is the only sanctioned LLM
# provider (CLAUDE.md §17.1) — no other provider key is read.
ANTHROPIC_API_KEY=

# ── Required only for the GitHub repository-access integration ────────────
# NOT required at startup, and NOT the student sign-in flow (that's the
# GitHub provider configured directly in the Supabase dashboard — ADR-001,
# apps/web/src/features/auth/README.md). This is a separate GitHub OAuth
# App for reading repositories once a student grants access (PRD FR-1.2),
# validated lazily by apps/web/src/lib/github/env.ts.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Optional ───────────────────────────────────────────────────────────────
# Has a default; never blocks startup.
NODE_ENV=development
